# Copia este archivo como .env y completa los valores. .env no se versiona.
DB_URL=jdbc:postgresql://localhost:5432/dulces_aromas
DB_USER=dulces_aromas
DB_PASSWORD=

# Primer administrador. Se crea al arrancar si no hay ninguno activo; después puedes borrar estas líneas.
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Servidor de correo para recuperar contraseñas. Vacío en desarrollo: el enlace aparece en el registro de la API.
MAIL_HOST=
MAIL_PUERTO=587
MAIL_USUARIO=
MAIL_CONTRASENA=
MAIL_REMITENTE=
RECUPERACION_URL=http://localhost:8081/recuperar

# Orígenes del Panel web, separados por comas.
CORS_ORIGENES=http://localhost:8081

# Contraseña de las cuentas de demostración que crea demo/cargar_demo.py (mínimo 8 caracteres, letra y número).
DEMO_CONTRASENA=
